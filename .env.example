APP_NAME="Moto Manager API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# =========================================================================
# BASE DE DONNÉES — configuration ACTIVE : MySQL en LOCAL (développement)
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moto_api
DB_USERNAME=ismael
DB_PASSWORD=Dev@2026Mysql!

# Autres comptes MySQL locaux disponibles (au choix, remplacez DB_USERNAME/DB_PASSWORD ci-dessus) :
#   root  / Root@2026!        -> accès complet (admin serveur MySQL)
#   ismael / Dev@2026Mysql!   -> compte développeur (utilisé par défaut ci-dessus)
#   admin / Admin@2026!       -> compte administrateur applicatif
#
# Créez d'abord la base si elle n'existe pas :
#   mysql -u root -p -e "CREATE DATABASE moto_api CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#   mysql -u root -p -e "CREATE USER 'ismael'@'localhost' IDENTIFIED BY 'Dev@2026Mysql!';"
#   mysql -u root -p -e "GRANT ALL PRIVILEGES ON moto_api.* TO 'ismael'@'localhost'; FLUSH PRIVILEGES;"

# =========================================================================
# BASE DE DONNÉES — ALTERNATIVE : Neon (PostgreSQL, cloud, prod / staging)
# Pour basculer vers Neon : commentez le bloc MySQL ci-dessus et décommentez
# tout le bloc ci-dessous (ou passez simplement DB_CONNECTION=pgsql + DATABASE_URL).
# =========================================================================
# DB_CONNECTION=pgsql
# DB_HOST=ep-xxxx-xxxx.eu-central-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your_neon_password
# DB_SSLMODE=require
#
# Alternative recommandée par Neon : une seule variable DATABASE_URL
# (config/database.php l'utilise automatiquement en priorité si définie) :
# DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-xxxx.neon.tech/neondb?sslmode=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost
MONTANT_VERSEMENT_MENSUEL_DEFAUT=600000
VERSEMENT_VOITURE_JOURNALIER=100000
