APP_NAME="Moto Manager API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Antananarivo
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL local (renseigner vos propres identifiants)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moto_api
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# PostgreSQL / Neon : utiliser ce bloc à la place du bloc MySQL
# DB_CONNECTION=pgsql
# DB_HOST=CHANGE_ME
# DB_PORT=5432
# DB_DATABASE=CHANGE_ME
# DB_USERNAME=CHANGE_ME
# DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# DB_SSLMODE=require
# DATABASE_URL=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
MONTANT_VERSEMENT_MENSUEL_DEFAUT=600000
VERSEMENT_VOITURE_JOURNALIER=100000

# ------------------------------------------------------------------
# ENTERPRISE AUTOMATION / AI
# ------------------------------------------------------------------
AUTOMATION_WEBHOOK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
N8N_WEBHOOK_URL=http://n8n:5678/webhook/moto-events
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT=45

WHATSAPP_ENABLED=false
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
