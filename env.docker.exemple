APP_NAME="Moto Manager API"
APP_ENV=local
APP_KEY=base64:BOrk6l5NME8kyCZW4G2LGvc6wimVoG6Xd1l5fD/7Ipc=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# =========================================================================
# BASE DE DONNÉES — MySQL conteneurisé (service "mysql" du docker-compose)
# =========================================================================
# ⚠️ DB_HOST=mysql, PAS 127.0.0.1 : dans Docker, 127.0.0.1 pointe vers le
# conteneur lui-même, pas vers ta machine hôte ni vers un autre conteneur.
# "mysql" est le nom du service dans docker-compose.yml, résolu via le
# réseau Docker interne "fleetmoto".
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=moto_api
DB_USERNAME=root
DB_PASSWORD=Root@2026!

# Autres comptes disponibles dans le conteneur MySQL (au choix) :
#   root   / Root@2026!       -> accès complet (admin serveur MySQL)
#   ismael / Dev@2026Mysql!   -> compte développeur
# (créés automatiquement par les variables MYSQL_* du docker-compose)

# =========================================================================
# BASE DE DONNÉES — ALTERNATIVE : Neon (PostgreSQL, cloud, prod / staging)
# Pour basculer vers Neon : commentez le bloc MySQL ci-dessus et décommentez
# tout le bloc ci-dessous (ou passez simplement DB_CONNECTION=pgsql + DATABASE_URL).
# =========================================================================
# DB_CONNECTION=pgsql
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=npg_qC0hQUJabw8E
# DB_SSLMODE=require
# DB_HOST=ep-divine-shadow-auicoj8c.c-10.us-east-1.aws.neon.tech
# DATABASE_URL=postgresql://neondb_owner:npg_qC0hQUJabw8E@ep-divine-shadow-auicoj8c.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# =========================================================================
# MAIL — Mailpit (capture les emails en local, ne les envoie jamais pour de vrai)
# Activer le conteneur : docker compose --profile mail up -d
# =========================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@fleetmoto.local"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# PORTS EXPOSÉS PAR LE STACK DOCKER (modifiables si conflit sur ta machine)
# =========================================================================
APP_PORT=8000
MYSQL_PORT=3306
PHPMYADMIN_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

SANCTUM_STATEFUL_DOMAINS=localhost
MONTANT_VERSEMENT_MENSUEL_DEFAUT=600000
VERSEMENT_VOITURE_JOURNALIER=100000